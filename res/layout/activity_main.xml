<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cargo_white" />

    <!-- Branded loading screen, shown until the first page finishes. -->
    <LinearLayout
        android:id="@+id/loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_background"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_logo" />

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/cargo_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/loading_text"
            android:textColor="@color/cargo_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Native error screen: no browser error page is ever shown. -->
    <LinearLayout
        android:id="@+id/error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="34dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:adjustViewBounds="true"
            android:alpha="0.9"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_logo" />

        <TextView
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/error_title"
            android:textColor="@color/cargo_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/error_generic_detail"
            android:textColor="@color/cargo_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retry_button"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/retry_button"
            android:text="@string/retry"
            android:textColor="@color/cargo_deep"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Startup splash lives inside this activity: no activity switch, no flicker. -->
    <LinearLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_background"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="172dp"
            android:layout_height="172dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.04"
            android:text="@string/app_name"
            android:textColor="@color/cargo_white"
            android:textSize="31sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:letterSpacing="0.16"
            android:text="@string/splash_tagline"
            android:textColor="@color/cargo_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/splash_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:alpha="0.65"
            android:textColor="@color/cargo_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
